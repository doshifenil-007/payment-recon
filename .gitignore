dist/
**/dist/
dist-ssr/
build/
**/build/
out/
.next/
.nuxt/
.output/

# ==========================================
# 3. ENVIRONMENT VARIABLES & SECRETS
# ==========================================
.env
.env.*
**/.env
**/.env.*

# Keep example environment templates
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ==========================================
